test-suite jpeg-turbo-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      FFITest
      Paths_jpeg_turbo
  autogen-modules:
      Paths_jpeg_turbo
  hs-source-dirs:
      test
  default-extensions:
      BangPatterns
      BlockArguments
      GADTs
      ImportQualifiedPost
      LambdaCase
      NamedFieldPuns
      OverloadedStrings
      PatternSynonyms
      RecordWildCards
      TupleSections
      TypeApplications
      TypeFamilies
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wno-missing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-tool-depends:
      tasty-discover:tasty-discover
  build-depends:
      base >=4.7 && <5
    , bytestring
    , jpeg-turbo
    , tasty
    , tasty-discover
    , tasty-hunit
  default-language: Haskell2010
