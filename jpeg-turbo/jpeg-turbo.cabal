      base >=4.7 && <5
    , bytestring >=0.10 && <1
  default-language: Haskell2010
  if arch(aarch64)
    cc-options: -DNEON_INTRINSICS
    c-sources:
        cbits/mozjpeg/simd/arm/aarch64/jchuff-neon.c
        cbits/mozjpeg/simd/arm/aarch64/jsimd.c
        cbits/mozjpeg/simd/arm/jccolor-neon.c
        cbits/mozjpeg/simd/arm/jcgray-neon.c
        cbits/mozjpeg/simd/arm/jcphuff-neon.c
        cbits/mozjpeg/simd/arm/jcsample-neon.c
        cbits/mozjpeg/simd/arm/jdcolor-neon.c
