cabal-version: 2.2

name:           jpeg-turbo
version:        0.1.0.0
synopsis:       FFI bindings to libjpeg-turbo
description:    Faster and more capable codec for JPEG images using libjpeg-turbo.
                .
                libjpeg-turbo 3.1.4.1 is compiled from the bundled source,
                with the Neon SIMD extensions on aarch64 and the C code paths
                on other architectures. CMake, NASM and pkg-config are not needed.
                .
                <https://libjpeg-turbo.org/Documentation>
category:       Codec, Image
author:         IC Rainbow
maintainer:     aenor.realm@gmail.com
copyright:      2024 IC Rainbow, 2026 SimpleX Chat Ltd
license:        BSD-3-Clause AND IJG AND Zlib
license-files:
    LICENSE
    cbits/libjpeg-turbo/LICENSE.md
    cbits/libjpeg-turbo/README.ijg
build-type:     Simple
extra-source-files:
    CHANGELOG.md
    cbits/*.h
    cbits/libjpeg-turbo/src/*.c
    cbits/libjpeg-turbo/src/*.h
    cbits/libjpeg-turbo/simd/jsimd.h
    cbits/libjpeg-turbo/simd/arm/*.c
    cbits/libjpeg-turbo/simd/arm/*.h
    cbits/libjpeg-turbo/simd/arm/aarch64/*.c

source-repository head
  type: git
  location: https://gitlab.com/dpwiz/hs-jpeg-turbo

library
  exposed-modules:
      TurboJPEG2
      TurboJPEG3
  other-modules:
      Paths_jpeg_turbo
  autogen-modules:
      Paths_jpeg_turbo
  hs-source-dirs:
      src
  default-extensions:
      BangPatterns
      BlockArguments
      GADTs
      ImportQualifiedPost
      LambdaCase
      NamedFieldPuns
      OverloadedStrings
      PatternSynonyms
      RecordWildCards
      TupleSections
      TypeApplications
      TypeFamilies
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wno-missing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  cc-options: -DBMP_SUPPORTED -DPPM_SUPPORTED
  include-dirs:
      cbits
      cbits/libjpeg-turbo/src
  c-sources:
