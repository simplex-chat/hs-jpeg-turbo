cabal-version: 2.2

name:           jpeg-turbo
version:        0.1.0.0
synopsis:       FFI bindings to libjpeg-turbo
description:    Faster and more capable codec for JPEG images using libjpeg-turbo.
                .
                mozjpeg 08265790, based on libjpeg-turbo 3.0.5, is compiled from
                the bundled source, with the Neon SIMD extensions on aarch64 and
                the C code paths on other architectures. CMake, NASM and
                pkg-config are not needed.
                .
                <https://libjpeg-turbo.org/Documentation>
category:       Codec, Image
author:         IC Rainbow
maintainer:     aenor.realm@gmail.com
copyright:      2024 IC Rainbow, 2026 SimpleX Chat Ltd
license:        BSD-3-Clause AND IJG AND Zlib
license-files:
    LICENSE
    cbits/mozjpeg/LICENSE.md
    cbits/mozjpeg/README.ijg
build-type:     Simple
extra-source-files:
    CHANGELOG.md
    cbits/*.h
    cbits/mozjpeg/*.c
    cbits/mozjpeg/*.h
    cbits/mozjpeg/simd/jsimd.h
    cbits/mozjpeg/simd/arm/*.c
    cbits/mozjpeg/simd/arm/*.h
    cbits/mozjpeg/simd/arm/aarch64/*.c

source-repository head
  type: git
  location: https://gitlab.com/dpwiz/hs-jpeg-turbo

library
  exposed-modules:
      TurboJPEG2
      TurboJPEG3
  other-modules:
      Paths_jpeg_turbo
  autogen-modules:
      Paths_jpeg_turbo
  hs-source-dirs:
      src
  default-extensions:
      BangPatterns
      BlockArguments
      GADTs
      ImportQualifiedPost
      LambdaCase
      NamedFieldPuns
      OverloadedStrings
      PatternSynonyms
      RecordWildCards
      TupleSections
      TypeApplications
      TypeFamilies
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wno-missing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  cc-options: -DBMP_SUPPORTED -DPPM_SUPPORTED
  include-dirs:
      cbits
      cbits/mozjpeg
  c-sources:
      cbits/mozjpeg/jcapimin.c
      cbits/mozjpeg/jcapistd.c
      cbits/mozjpeg/jccoefct.c
