foreign import ccall "turbojpeg.h tj3DecompressHeader" tj3DecompressHeader :: TjHandle D -> Ptr CUChar -> CSize -> IO CInt

newtype TJPARAM = TJPARAM CInt
  deriving (Eq, Ord, Show)

